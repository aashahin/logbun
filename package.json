{
  "name": "logbun",
  "version": "0.2.0",
  "type": "module",
  "description": "Production-ready audit logging for Bun-based multi-tenant SaaS platforms.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters/sqlite": {
      "types": "./dist/adapters/sqlite.d.ts",
      "import": "./dist/adapters/sqlite.js",
      "require": "./dist/adapters/sqlite.cjs"
    },
    "./adapters/turso": {
      "types": "./dist/adapters/turso.d.ts",
      "import": "./dist/adapters/turso.js",
      "require": "./dist/adapters/turso.cjs"
    },
    "./adapters/clickhouse": {
      "types": "./dist/adapters/clickhouse.d.ts",
      "import": "./dist/adapters/clickhouse.js",
      "require": "./dist/adapters/clickhouse.cjs"
    },
    "./plugins/elysia": {
      "types": "./dist/plugins/elysia.d.ts",
      "import": "./dist/plugins/elysia.js",
      "require": "./dist/plugins/elysia.cjs"
    },
    "./plugins/hono": {
      "types": "./dist/plugins/hono.d.ts",
      "import": "./dist/plugins/hono.js",
      "require": "./dist/plugins/hono.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint .",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@libsql/client": ">=0.6.0",
    "@clickhouse/client": ">=1.0.0",
    "elysia": ">=1.0.0",
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    },
    "@clickhouse/client": {
      "optional": true
    },
    "elysia": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.1.2",
    "elysia": "^1.2.25",
    "hono": "^4.7.0",
    "tsup": "^8.4.0",
    "typescript": "5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashahin/logbun.git"
  },
  "keywords": [
    "audit",
    "log",
    "logging",
    "audit-log",
    "audit-logging",
    "audit-log-storage",
    "audit-log-storage-provider",
    "audit-log-storage-provider-turso",
    "audit-log-storage-provider-clickhouse",
    "audit-log-storage-provider-sqlite",
    "audit-log-storage-provider-factory",
    "audit-log-storage-provider-factory-turso",
    "audit-log-storage-provider-factory-clickhouse",
    "audit-log-storage-provider-factory-sqlite",
    "audit-log-storage-provider-factory-turso-clickhouse-sqlite",
    "bun",
    "bunjs",
    "elysia",
    "hono"
  ]
}
